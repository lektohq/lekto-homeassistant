{
  "entity": {
    "event": {
      "document": {
        "default": "mdi:file-document-outline"
      }
    },
    "sensor": {
      "classifier_confirmed_since": {
        "default": "mdi:school"
      },
      "documents": {
        "default": "mdi:file-document-multiple"
      },
      "health": {
        "default": "mdi:heart-pulse",
        "state": {
          "degraded": "mdi:alert",
          "down": "mdi:close-octagon"
        }
      },
      "inbox_intervene": {
        "default": "mdi:alert-circle"
      },
      "inbox_new": {
        "default": "mdi:email-newsletter"
      },
      "inbox_open": {
        "default": "mdi:inbox"
      },
      "inbox_processing": {
        "default": "mdi:cog-sync"
      },
      "inbox_review": {
        "default": "mdi:eye-check"
      },
      "inbox_worst_lane": {
        "default": "mdi:traffic-light",
        "state": {
          "green": "mdi:email-newsletter",
          "red": "mdi:alert-circle",
          "yellow": "mdi:eye-check"
        }
      },
      "jobs_due": {
        "default": "mdi:timer-sand"
      },
      "jobs_failed": {
        "default": "mdi:alert-circle-outline"
      },
      "search_queued": {
        "default": "mdi:database-search"
      },
      "worker_last_started": {
        "default": "mdi:play-circle-outline"
      }
    }
  },
  "services": {
    "fetch_mail": {
      "service": "mdi:email-sync"
    },
    "upload": {
      "service": "mdi:file-upload"
    }
  }
}
